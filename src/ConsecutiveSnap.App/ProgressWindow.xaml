<Window x:Class="ConsecutiveSnap.App.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="False"
        Background="#F2191B26"
        FontFamily="Segoe UI, Yu Gothic UI"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <!-- 上端のアクセント線で、実行中であることをさりげなく示す -->
    <Border BorderBrush="#5B50E8" BorderThickness="0,3,0,0" Padding="16,11,16,12">
        <StackPanel>
            <TextBlock x:Name="MainText" Foreground="#F4F5FA" FontSize="17" FontWeight="Bold"/>
            <TextBlock x:Name="SubText" Foreground="#A9AEC2" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>
    </Border>
</Window>
