<Window x:Class="ConsecutiveSnap.App.StepEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="操作ステップの編集"
        Icon="Assets/AppIcon.ico"
        Style="{StaticResource WindowStyle}"
        Width="470" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="20,18,20,18">
        <TextBlock Text="操作の種類" Style="{StaticResource SectionTitle}"/>
        <WrapPanel Margin="0,10,0,14">
            <RadioButton x:Name="KeyRadio" Content="キー入力" Margin="0,0,18,6" IsChecked="True" Checked="TypeChanged"/>
            <RadioButton x:Name="ClickRadio" Content="マウスクリック" Margin="0,0,18,6" Checked="TypeChanged"/>
            <RadioButton x:Name="WheelRadio" Content="マウスホイール" Margin="0,0,18,6" Checked="TypeChanged"/>
            <RadioButton x:Name="WaitRadio" Content="待機" Margin="0,0,0,6" Checked="TypeChanged"/>
        </WrapPanel>

        <Border Style="{StaticResource Card}" Margin="0" Padding="16">
            <Grid>
                <!-- キー入力 -->
                <StackPanel x:Name="KeyPanel">
                    <TextBlock Text="下の欄をクリックして、送りたいキー（修飾キー付きも可）を押してください。" Style="{StaticResource Hint}"/>
                    <TextBox x:Name="KeyBox" Margin="0,10,0,0" FontSize="16" FontWeight="SemiBold"
                             IsReadOnly="True" IsReadOnlyCaretVisible="False"
                             InputMethod.IsInputMethodEnabled="False"
                             PreviewKeyDown="KeyBox_PreviewKeyDown"
                             Text="（ここでキーを押す）"/>
                </StackPanel>

                <!-- マウスクリック -->
                <StackPanel x:Name="ClickPanel" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="ClickXBox" Width="90" TextAlignment="Right"/>
                        <TextBlock Text="Y" VerticalAlignment="Center" Margin="20,0,8,0"/>
                        <TextBox x:Name="ClickYBox" Width="90" TextAlignment="Right"/>
                    </StackPanel>
                    <Button Content="画面上でクリック位置を指定..." Margin="0,12,0,0" HorizontalAlignment="Left"
                            Click="PickClickPointButton_Click"/>
                    <TextBlock Text="座標は物理ピクセルで、主画面の左上が基準です（サブ画面が左や上にあると負の値になります）。"
                               Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- マウスホイール -->
                <StackPanel x:Name="WheelPanel" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="WheelDownRadio" Content="下へ（次へ進む方向）" IsChecked="True" Margin="0,0,20,0"/>
                        <RadioButton x:Name="WheelUpRadio" Content="上へ（戻る方向）"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="回す量" VerticalAlignment="Center"/>
                        <TextBox x:Name="WheelNotchBox" Width="70" Margin="10,0,8,0" TextAlignment="Right"/>
                        <TextBlock Text="ノッチ（1〜100）" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}"/>
                    </StackPanel>
                    <CheckBox x:Name="WheelPositionCheck" Margin="0,14,0,0"
                              Content="位置を指定してから回す" Checked="WheelPositionChanged" Unchecked="WheelPositionChanged"/>
                    <TextBlock Text="ホイールはマウスカーソルの下にあるウィンドウに届きます。指定しない場合は、その時点のカーソル位置で回します。"
                               Style="{StaticResource Hint}" Margin="26,4,0,0"/>
                    <StackPanel x:Name="WheelPositionPanel" Visibility="Collapsed" Margin="26,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="WheelXBox" Width="90" TextAlignment="Right"/>
                            <TextBlock Text="Y" VerticalAlignment="Center" Margin="20,0,8,0"/>
                            <TextBox x:Name="WheelYBox" Width="90" TextAlignment="Right"/>
                        </StackPanel>
                        <Button Content="画面上で位置を指定..." Margin="0,10,0,0" HorizontalAlignment="Left"
                                Click="PickWheelPointButton_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- 待機 -->
                <StackPanel x:Name="WaitPanel" Visibility="Collapsed" Orientation="Horizontal">
                    <TextBox x:Name="WaitBox" Width="100" TextAlignment="Right"/>
                    <TextBlock Text="ミリ秒（0〜600000）" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource SubTextBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,12,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Style="{StaticResource PrimaryButton}" Width="90" IsDefault="True" Click="OkButton_Click" Margin="0,0,8,0"/>
            <Button Content="キャンセル" Width="100" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
