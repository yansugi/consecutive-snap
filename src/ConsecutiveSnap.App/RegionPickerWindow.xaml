<Window x:Class="ConsecutiveSnap.App.RegionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Topmost="True"
        Background="Black"
        Cursor="Cross"
        KeyDown="Window_KeyDown">
    <Grid>
        <!-- Stretch=Noneだと画像本来の物理ピクセル数がそのままDIPとして使われ、高DPI環境で
             ウィンドウ（DPIスケールで割った正しいDIPサイズ）からはみ出してしまうため、
             Fillでウィンドウ全体に収まるよう拡縮する。 -->
        <Image x:Name="BackgroundImage" Stretch="Fill"/>

        <Canvas x:Name="OverlayCanvas"
                Background="Transparent"
                MouseLeftButtonDown="OverlayCanvas_MouseLeftButtonDown"
                MouseMove="OverlayCanvas_MouseMove"
                MouseLeftButtonUp="OverlayCanvas_MouseLeftButtonUp">
            <Rectangle x:Name="DimTop" Fill="#8C0A0C10"/>
            <Rectangle x:Name="DimBottom" Fill="#8C0A0C10"/>
            <Rectangle x:Name="DimLeft" Fill="#8C0A0C10"/>
            <Rectangle x:Name="DimRight" Fill="#8C0A0C10"/>

            <Rectangle x:Name="SelectionBorder"
                       Stroke="#E8552F" StrokeThickness="1.5" Fill="Transparent"
                       Visibility="Collapsed"/>

            <Border x:Name="SizeBadge"
                    Background="#DC14161A" CornerRadius="4" Padding="6,3"
                    Visibility="Collapsed">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" FontFamily="Yu Gothic UI"/>
            </Border>
        </Canvas>

        <Border Background="#D2141619" CornerRadius="16"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                Padding="16,8" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="HintText" Foreground="#F1F2F4" FontSize="12.5" FontFamily="Yu Gothic UI" Margin="0,0,14,0"/>
                <TextBlock Foreground="#F1F2F4" FontSize="12.5" FontFamily="Yu Gothic UI">
                    <Run Text="Esc" FontWeight="Bold"/><Run Text=" キャンセル"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
